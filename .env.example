DATABASE_URL=postgresql+psycopg://postgres:yourpass@localhost:5432/cuewise
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=cuewise-api
JWT_AUDIENCE=cuewise-client
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM via OpenRouter (https://openrouter.ai/keys). Set the key and the model together, or leave
# both blank to run without the LLM (answers still work; the interviewer reaction is null).
# Set a spend limit on the key in the OpenRouter dashboard: there is no app-level rate limit yet.
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Per attempt; retries happen only on timeouts, 429 and 5xx, within the total budget.
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_TOTAL_BUDGET_SECONDS=30
# Hard cap on reply length (cost and latency).
LLM_MAX_TOKENS=150
