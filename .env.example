# The pgvector Docker database from compose.yaml (see README: "Development database").
DATABASE_URL=postgresql+psycopg://postgres:postgres_236@127.0.0.1:5433/cuewise
DEBUG=true
# Labels Langfuse traces (development, production, ...).
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=cuewise-api
JWT_AUDIENCE=cuewise-client
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM providers, in order: the first is used, later ones are reserved for the fallback chain (not built yet).
# Leave LLM_PROVIDERS blank to run without the LLM (interviews still work, with questions from the question bank).
# Every listed provider needs its own block below (LLM_<VENDOR>_API_KEY, _MODEL, _BASE_URL); all are
# OpenAI-compatible chat completions endpoints.
LLM_PROVIDERS=google
# Google AI Studio (https://aistudio.google.com/apikey), via its OpenAI-compatible endpoint.
LLM_GOOGLE_API_KEY=your_google_ai_studio_key
LLM_GOOGLE_MODEL=gemini-3.5-flash-lite
LLM_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# A second vendor later looks like this (plus its name in LLM_PROVIDERS, e.g. google,cloudflare):
# LLM_CLOUDFLARE_API_KEY=...
# LLM_CLOUDFLARE_MODEL=...
# LLM_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# Per attempt; retries happen only on timeouts, 429 and 5xx, within the total budget.
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_TOTAL_BUDGET_SECONDS=30
# Hard cap on reply length (cost and latency). Reasoning models spend tokens thinking before they write the
# reply, and a cap that is too small ends with an empty reply (finish_reason=length); 800 leaves room for both.
LLM_MAX_TOKENS=800
# End-of-interview feedback: a score call (reads the whole interview, returns JSON), then a write call (the text).
# One budget for both; each call still obeys the per-attempt and per-call limits above. A feedback still "generating"
# after budget + margin is treated as crashed and the next request takes it over.
FEEDBACK_TOTAL_BUDGET_SECONDS=60
FEEDBACK_STALE_MARGIN_SECONDS=30
# The largest interview's score reply is about 4,000 tokens; a reply cut off by the cap is invalid and fails.
FEEDBACK_SCORE_MAX_TOKENS=6000
FEEDBACK_WRITE_MAX_TOKENS=2000
# Low, so scoring the same interview twice gives (nearly) the same scores.
FEEDBACK_SCORE_TEMPERATURE=0.2

# Embeddings for picking reference notes at interview start (Slice 8a). Google's native embedding endpoint, not the
# OpenAI-compatible one above: only the native one takes the query/document task types and a reduced vector size.
# Uses LLM_GOOGLE_API_KEY (no second key). Without that key, notes are picked by role and level only (no embedding).
EMBEDDING_MODEL=gemini-embedding-001
# Must equal the database's vector column size (768); a different size needs a new migration and re-ingestion.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
# Per attempt. At interview start the whole embedding step is also capped at 5 seconds, then falls back to role/level.
EMBEDDING_TIMEOUT_SECONDS=10

# Speech-to-text for voice answers (Deepgram pre-recorded /v1/listen, https://console.deepgram.com).
# Leave the key blank to turn voice answers off; the endpoint then answers 503 and everything else works.
# Audio is sent without mip_opt_out, so Deepgram may use it in its Model Improvement Program (opting out costs more).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_BASE_URL=https://api.deepgram.com/
# Per attempt; retries happen only on timeouts, 429 and 5xx. The total budget stays under the web app's 25 s timeout.
TRANSCRIPTION_TIMEOUT_SECONDS=15
TRANSCRIPTION_MAX_RETRIES=1
TRANSCRIPTION_TOTAL_BUDGET_SECONDS=20

# Langfuse tracing (https://cloud.langfuse.com). Leave the keys blank to turn tracing off; both are needed to turn it on.
# Traces carry the full prompts and replies, so use a project you are happy to hold interview content.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
